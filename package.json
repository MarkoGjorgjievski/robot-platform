{
  "name": "robot-platform",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "pnpm --filter @robot/dashboard dev",
    "dev:all": "turbo dev",
    "test:scraper": "source .env 2>/dev/null; pnpm --filter @robot/scraper exec tsx src/test-run.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
