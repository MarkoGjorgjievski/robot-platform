# Copy to .env at the repo root. Everything reads it via @robot/db / the CLI entrypoints.
# Variables already exported in your shell win over this file.

# PostgreSQL. Any Postgres 16 works; the documented local setup is Docker:
#   docker run -d --name robot-platform-db \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=robot_platform \
#     -p 5432:5432 -v robot-platform-pgdata:/var/lib/postgresql/data postgres:16
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/robot_platform

# Claude API key. Without it @robot/agent falls back to Ollama (ollama serve).
# Required for: the dogfood harness, live test-run.ts, and any uncached extraction.
ANTHROPIC_API_KEY=

# Jev at Verify, in shadow (spec 2026-10-16): off unless JEV_SHADOW=1 and a TypeSafe key is set.
# TYPESAFE_API_KEY=
# JEV_SHADOW=
# Readings per UTC day across the api-server (one per proof-page capture); default 2000.
# JEV_DAILY_READINGS=

# Scheduled website checks (spec 2026-10-21 §3.3): set to `on` to run the free scheduled website checks every
# hour (proof pages + listing sample, no AI). Off by default.
# WEBSITE_CHECKS=
# Days between a website's scheduled checks (a Verify or a check reading its pages moves the next one on); default 3.
# WEBSITE_CHECK_DAYS=

# Set to 1 to watch the browser during a scrape
# HEADFUL=1

# Comma-separated emails that land in ops mode (staff), case-insensitive and trimmed; empty means nobody is an operator.
# OPS_EMAILS=

# ─── Optional knobs (defaults shown) ───

# Where @robot/app finds the api-server (Vite build-time var).
# VITE_API_URL=http://localhost:4000

# api-server listen port.
# PORT=4000

# Comma-separated origins the api-server accepts (CORS). An isolated pair (app :3100 -> api :4100) adds its own.
# APP_ORIGINS=http://localhost:3000

# Where analyze screenshots are written and served from.
# CAPTURES_DIR=packages/api-server/public/captures

# Model overrides for @robot/agent (defaults live in packages/agent/src/models.ts).
# ROBOT_EXTRACTION_MODEL=
# ROBOT_JUDGE_MODEL=
# ROBOT_OLLAMA_MODEL=

# Ollama endpoint for the no-API-key fallback.
# OLLAMA_BASE_URL=http://localhost:11434

# Set to 1 for verbose page-capture logging in @robot/browser.
# CAPTURE_DEBUG=1
